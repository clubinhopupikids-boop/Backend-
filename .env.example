# ─────────────────────────────────────────────────────────────
# Pupi Kids / PupiMundo backend — example environment variables.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
# Optional. Defaults to 0.0.0.0 outside production and 127.0.0.1 in production.
HOST=
PORT=3000
APP_NAME=pupikids-backend
APP_PREFIX=api

# CORS — comma separated list of allowed origins. Use "*" only for local dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082

# Security
# Generate a strong random string (e.g. `openssl rand -base64 64`). 32+ chars minimum.
JWT_SECRET=replace-me-with-a-long-random-secret-min-32-chars
JWT_ACCESS_TTL=1h
JWT_ISSUER=pupikids

# Temporary parental authorization (separate from the main session JWT).
# Configure an independent random secret in production. Never reuse JWT_SECRET.
PARENT_ACCESS_JWT_SECRET=
# 15 minutes. Accepted range: 60-3600 seconds.
PARENT_ACCESS_TTL_SECONDS=900

# Six-digit parental PIN throttling. Password fallback is never blocked by these values.
PARENT_PIN_MAX_ATTEMPTS=5
PARENT_PIN_DELAY_AFTER_ATTEMPTS=3
PARENT_PIN_DELAY_MS=750
PARENT_PIN_LOCK_SECONDS=300

# Product calendar used to derive daily, ISO-weekly and monthly mission periods.
MISSION_TIME_ZONE=America/Sao_Paulo

# Cloudflare R2 / sensory-library media. Keep the bucket private by default:
# the backend creates short-lived read URLs and never exposes these credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional when R2_ACCOUNT_ID is present; defaults to the Cloudflare R2 S3 endpoint.
R2_ENDPOINT=
# Optional public/CDN base URL. When set, public media URLs are used instead of signatures.
R2_PUBLIC_BASE_URL=
# 30 minutes. Accepted range: 60-86400 seconds.
R2_SIGNED_URL_TTL_SECONDS=1800

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL=postgresql://pupikids:pupikids@localhost:5432/pupikids?schema=public

# Swagger / OpenAPI
# Swagger UI is only enabled when NODE_ENV !== 'production'.
SWAGGER_PATH=docs
