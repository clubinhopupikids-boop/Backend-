// Pupi Kids / PupiMundo — Prisma schema (foundation)
// See backend/README.md for the full model overview.
//
// Design notes:
// - UUIDs for every entity.
// - Responsible owns the account; a Responsible has many Children.
// - Child has a 1:1 ExperienceSettings (created alongside the child).
// - Child has N:N CommunicationMode via ChildCommunicationMode.
// - `DevelopmentProfile` is a free-form enum label used only as initial setup
//   information. It MUST NOT drive branching clinical logic on the backend.

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Supported UI languages. The backend stores/returns them; full i18n of the
/// mobile apps is handled client-side.
enum Language {
  PT_BR
  EN
  ES
}

/// Initial development profile informed by the responsible during setup.
/// This is a label, NOT a clinical classification. The product NEVER branches
/// its flows by profile — profiles only adjust experience parameters.
enum DevelopmentProfile {
  TYPICAL_DEVELOPMENT
  TEA
  ADHD
  DOWN_SYNDROME
  MILD_INTELLECTUAL_DISABILITY
  DEVELOPMENTAL_DELAY
  LEARNING_DISABILITIES
  SENSORY_SENSITIVITY
  LOW_VISION
  HIGH_ABILITIES_GIFTEDNESS
  PREFER_NOT_TO_INFORM
}

/// Recurrence of a mission. A completion is tied to one of these periods.
enum MissionPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

/// Optional reflection provided after a mission has already been completed.
enum MissionFeedbackRating {
  VERY_FUN
  FUN
  SO_SO
  DIFFICULT
  VERY_DIFFICULT
}

/// Rarity is catalog metadata. Only active NORMAL missions participate in the
/// current rotation; RARE entries are retained for future product work.
enum MissionRarity {
  NORMAL
  RARE
}

/// Publication state shared by future game and library catalog entries.
enum CatalogStatus {
  AVAILABLE
  COMING_SOON
}

enum GameCategory {
  EMOTIONS
  CREATIVITY
  LOGIC
  ATTENTION_MEMORY
}

enum LibraryContentType {
  STORIES
  MUSIC
  VIDEOS
}

/// Technical representation of a library asset. Editorial type and technical
/// format are intentionally separate: a MUSIC item may be audio-only or a
/// video clip.
enum LibraryMediaFormat {
  AUDIO
  VIDEO
}

/// Optional catalog metadata. Themes are not an Android filter in this phase.
enum LibraryTheme {
  EMOTIONS
  ROUTINE
  SOCIAL
  DEVELOPMENT
  MOVEMENT
}

/// Communication modalities a child can use. A child may use several at once.
/// Modelled as a lookup table so the set is extensible without migrations
/// for every addition.
model CommunicationMode {
  id        String   @id @default(uuid()) @db.Uuid
  /// Stable machine code (e.g. VOICE, IMAGES_SYMBOLS). Unique.
  code      String   @unique
  /// Human readable label (presentation only).
  label     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  children ChildCommunicationMode[]

  @@map("communication_mode")
}

/// A responsible (parent/guardian) account. Owns the login credentials.
model Responsible {
  id                      String    @id @default(uuid()) @db.Uuid
  email                   String    @unique
  passwordHash            String    @map("password_hash")
  language                Language  @default(PT_BR)
  termsAcceptedAt         DateTime  @map("terms_accepted_at")
  parentPinHash           String?   @map("parent_pin_hash")
  parentPinCreatedAt      DateTime? @map("parent_pin_created_at")
  parentPinUpdatedAt      DateTime? @map("parent_pin_updated_at")
  parentPinFailedAttempts Int       @default(0) @map("parent_pin_failed_attempts")
  parentPinLockedUntil    DateTime? @map("parent_pin_locked_until")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  children Child[]

  @@map("responsible")
}

/// A child profile linked to a responsible. No independent login.
model Child {
  id                 String              @id @default(uuid()) @db.Uuid
  responsibleId      String              @map("responsible_id") @db.Uuid
  name               String
  birthDate          DateTime            @db.Date @map("birth_date")
  primaryLanguage    Language            @default(PT_BR) @map("primary_language")
  // Optional initial setup info. A label, never a clinical branch.
  developmentProfile DevelopmentProfile? @map("development_profile")
  /// Global child balances. Credits occur atomically with their source event.
  starBalance        Int                 @default(0) @map("star_balance")
  crystalBalance     Int                 @default(0) @map("crystal_balance")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  responsible Responsible           @relation(fields: [responsibleId], references: [id], onDelete: Cascade)
  settings     ExperienceSettings?
  communication ChildCommunicationMode[]
  missionCompletions MissionCompletion[]
  missionAssignments MissionAssignment[]

  @@index([responsibleId])
  @@map("child")
}

/// Catalog definition only. No catalog rows are seeded by this backend.
model Mission {
  id            String        @id @default(uuid()) @db.Uuid
  /// Stable catalog key used by seed, history and mobile integration.
  code          String        @unique
  title         String
  description   String
  /// Null for inactive rare missions that do not belong to a rotation yet.
  period        MissionPeriod?
  /// Original thematic grouping from the official mission document.
  theme         String?
  iconKey       String?       @map("icon_key")
  exclusionGroup String?      @map("exclusion_group")
  rarity        MissionRarity @default(NORMAL)
  starReward    Int           @default(0) @map("star_reward")
  crystalReward Int           @default(0) @map("crystal_reward")
  isActive      Boolean       @default(true) @map("is_active")
  displayOrder  Int           @default(0) @map("display_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  completions MissionCompletion[]
  assignments MissionAssignment[]

  @@index([period, isActive, displayOrder])
  @@map("mission")
}

/// Persisted, ordered set of missions offered to a child for one product
/// calendar period. Assignments are never removed when the cycle changes.
model MissionAssignment {
  id        String        @id @default(uuid()) @db.Uuid
  childId   String        @map("child_id") @db.Uuid
  missionId String        @map("mission_id") @db.Uuid
  period    MissionPeriod
  periodKey String        @map("period_key")
  slot      Int
  assignedAt DateTime     @default(now()) @map("assigned_at")

  child   Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Restrict)

  @@unique([childId, missionId, period, periodKey])
  @@unique([childId, period, periodKey, slot])
  @@index([childId, period, periodKey])
  @@index([missionId])
  @@map("mission_assignment")
}

/// Immutable record of the reward event for a child, mission and recurrence period.
/// The unique constraint is the persistence-level idempotency guarantee.
model MissionCompletion {
  id              String                @id @default(uuid()) @db.Uuid
  childId         String                @map("child_id") @db.Uuid
  missionId       String                @map("mission_id") @db.Uuid
  period          MissionPeriod
  periodKey       String                @map("period_key")
  starAwarded     Int                   @map("star_awarded")
  crystalAwarded  Int                   @map("crystal_awarded")
  completedAt     DateTime              @default(now()) @map("completed_at")
  feedbackRating  MissionFeedbackRating? @map("feedback_rating")
  feedbackComment String?               @map("feedback_comment")
  feedbackCreatedAt DateTime?           @map("feedback_created_at")
  feedbackUpdatedAt DateTime?           @map("feedback_updated_at")

  child   Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Restrict)

  @@unique([childId, missionId, period, periodKey])
  @@index([childId, period, periodKey])
  @@index([missionId])
  @@map("mission_completion")
}

/// Future game catalog. An empty table is a valid current application state.
model Game {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  category      GameCategory
  coverUrl      String?       @map("cover_url")
  starReward    Int           @default(0) @map("star_reward")
  crystalReward Int           @default(0) @map("crystal_reward")
  status        CatalogStatus @default(COMING_SOON)
  displayOrder  Int           @default(0) @map("display_order")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([category, status, displayOrder])
  @@map("game")
}

/// Sensory-library catalog. Object-storage keys are the persistent media
/// source of truth; public or signed URLs are resolved by the backend.
model LibraryContent {
  id              String             @id @default(uuid()) @db.Uuid
  /// Stable administrative/catalog key, never derived from the display title.
  code            String             @unique
  type            LibraryContentType
  title           String
  mediaFormat     LibraryMediaFormat? @map("media_format")
  mimeType        String?            @map("mime_type")
  storageKey      String?            @map("storage_key")
  thumbnailStorageKey String?        @map("thumbnail_storage_key")
  thumbnailUrl    String?            @map("thumbnail_url")
  mediaUrl        String?            @map("media_url")
  durationSeconds Int?               @map("duration_seconds")
  theme           LibraryTheme?
  status          CatalogStatus      @default(COMING_SOON)
  displayOrder    Int                @default(0) @map("display_order")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([type, status, displayOrder])
  @@map("library_content")
}

/// Per-child experience settings (1:1 with Child).
/// Defaults are technical placeholders — NOT clinical prescriptions.
/// Profile-to-parameter mapping is intentionally not encoded here.
model ExperienceSettings {
  id                                 String  @id @default(uuid()) @db.Uuid
  childId                            String  @unique @map("child_id") @db.Uuid
  animationSpeed                     Float   @default(1.0) @map("animation_speed")
  soundVolume                        Float   @default(0.8) @map("sound_volume")
  visualStimulusLevel                Float   @default(0.5) @map("visual_stimulus_level")
  pupiResponseTime                   Float   @default(1.0) @map("pupi_response_time")
  pupiSpeechFrequency                Float   @default(0.5) @map("pupi_speech_frequency")
  instructionComplexity              Float   @default(0.5) @map("instruction_complexity")
  maxSimultaneousInteractiveElements Int     @default(3) @map("max_simultaneous_interactive_elements")
  narrationEnabled                   Boolean @default(true) @map("narration_enabled")
  musicEnabled                       Boolean @default(true) @map("music_enabled")
  visualEffectsEnabled               Boolean @default(true) @map("visual_effects_enabled")
  createdAt                          DateTime @default(now()) @map("created_at")
  updatedAt                          DateTime @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("experience_settings")
}

/// Join table for the N:N relation between Child and CommunicationMode.
model ChildCommunicationMode {
  id                  String   @id @default(uuid()) @db.Uuid
  childId             String   @map("child_id") @db.Uuid
  communicationModeId String   @map("communication_mode_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  child      Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  mode       CommunicationMode @relation(fields: [communicationModeId], references: [id], onDelete: Cascade)

  @@unique([childId, communicationModeId])
  @@index([communicationModeId])
  @@map("child_communication_mode")
}
